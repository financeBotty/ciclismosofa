ObjC.import("Foundation");

const projectPath = "/Users/mmp/Ciclismosofa/cycling-game/game.js";
const sourceString = $.NSString.stringWithContentsOfFileEncodingError(
  projectPath,
  $.NSUTF8StringEncoding,
  null
);
if (!sourceString) throw new Error("No se pudo leer game.js");
const source = ObjC.unwrap(sourceString).replace(/\nwindow\.CiclimoTourRace[\s\S]*$/, "");

const tests = String.raw`
const assertMountain = (condition, message) => {
  if (!condition) throw new Error(message);
};

const climbs = [];
for (let seed = 1; seed <= 40; seed += 1) {
  const road = new Road(new SeededRandom(seed), 190, {
    name: "Etapa de prueba", type: "mountain", profile: "mountain", lengthKm: 190
  });
  climbs.push(...road.mountains);
  assertMountain(road.mountains.length >= 3, "Una etapa de montaña quedó sin suficientes puertos");
}
const averageLength = climbs.reduce((sum, climb) => sum + climb.lengthKm, 0) / climbs.length;
const averageGradient = climbs.reduce((sum, climb) => sum + climb.averageGradient, 0) / climbs.length;
assertMountain(averageLength >= 10, "Las ascensiones siguen siendo demasiado cortas");
assertMountain(averageGradient >= 6.2, "Las ascensiones siguen siendo demasiado suaves");
assertMountain(climbs.some((climb) => climb.lengthKm >= 18), "No aparecen puertos largos");
assertMountain(climbs.some((climb) => climb.averageGradient >= 9), "No aparecen rampas exigentes");
assertMountain(climbs.some((climb) => climb.maxGradient >= 12),
  "Los puertos no incluyen rampas realmente pindias");
assertMountain(climbs.every((climb) => climb.maxGradient <= 14.5),
  "Se ha generado una pendiente extrema o imposible");
assertMountain(climbs.some((climb) => climb.maxGradient - climb.averageGradient >= 1.5),
  "Los puertos siguen teniendo una pendiente uniforme sin sectores diferenciados");

const crowdRoad = new Road(new SeededRandom(91), 180, {
  name: "Público", type: "road", profile: "mixed", lengthKm: 180
});
assertMountain(crowdRoad.spectatorDensityAt(179) === 1, "La llegada no concentra público");
assertMountain(crowdRoad.intermediateSprints.every((point) => crowdRoad.spectatorDensityAt(point.km) === 1),
  "Alguna meta volante no concentra público");

const visualGame = Object.create(Game.prototype);
visualGame.height = 700;
visualGame.cameraFocusKm = 50;
visualGame.race = { road: { elevationAt: (km) => 500 + (km - 50) * 80 } };
const visualRise = visualGame.sideSurfaceY(50) - visualGame.sideSurfaceY(51);
assertMountain(visualRise >= 60, "La pendiente lateral no se aprecia suficientemente");
const visualRoadAngle = visualGame.sideRoadAngleAt(50, 800);
assertMountain(visualRoadAngle < -0.04, "La bicicleta lateral no acompaña el ángulo de subida");
assertMountain(SIDE_ROAD_ASPHALT_WIDTH >= 42 && SIDE_ROAD_SHOULDER_WIDTH >= 54,
  "La carretera lateral sigue siendo demasiado estrecha");
assertMountain(SIDE_ROAD_LANE_DEPTH >= 10,
  "Los cambios de carril siguen sin apreciarse en la vista lateral");
assertMountain(Math.abs(visualGame.sideLaneOffset(1)) <= SIDE_ROAD_ASPHALT_WIDTH / 2 - 8,
  "Un cambio de carril puede sacar al ciclista del asfalto lateral");
assertMountain(visualGame.lateralRiderViewportScale(390) <= 0.68,
  "Los ciclistas laterales siguen siendo demasiado grandes en un móvil estrecho");
assertMountain(visualGame.lateralRiderViewportScale(800) < 0.8,
  "Los ciclistas laterales no se reducen en móviles grandes");
assertMountain(visualGame.lateralRiderViewportScale(1200) === 1,
  "La reducción móvil está alterando también la vista lateral de escritorio");
assertMountain(visualGame.raceStructureScale(390) === 0.58 &&
  visualGame.raceStructureScale(800) === 0.72 && visualGame.raceStructureScale(1200) === 1,
  "Metas y vehículos no comparten una escala estructural responsive estable");
assertMountain(SIDE_FINISH_GATE_HEIGHT >= 180,
  "La meta lateral puede quedar oculta por el público");
assertMountain(TOP_SPRINT_GATE_HEIGHT >= 125 && SIDE_SPRINT_GATE_HEIGHT >= 180,
  "Las metas volantes siguen sin dejar suficiente altura libre");
const sprintGateGeometry = visualGame.lateralRaceGateGeometry(
  { km: 50, type: "sprint" },
  300,
  800
);
assertMountain(
  sprintGateGeometry.leftBaseY - visualGame.sideSurfaceY(sprintGateGeometry.leftKm) >
    SIDE_ROAD_ASPHALT_WIDTH / 2 &&
  visualGame.sideSurfaceY(sprintGateGeometry.rightKm) - sprintGateGeometry.rightBaseY >
    SIDE_ROAD_ASPHALT_WIDTH / 2,
  "Los postes de la meta volante no están anclados fuera de los dos bordes de la carretera"
);
assertMountain(typeof visualGame.renderLateralRoadsideProps === "function",
  "No se renderizan vehículos y bicicletas de aficionados");

const poseGame = Object.create(Game.prototype);
let poseGradient = 6;
poseGame.race = { road: { getGradient: () => poseGradient } };
const poseRider = {
  victory: false, crashTimer: 0, sprinting: false, attacking: 0,
  energy: 80, fatigue: 10, effort: 4, distance: 20
};
assertMountain(poseGame.riderPose(poseRider) === "normal",
  "El ritmo alto normal usa por error la postura de ataque");
poseRider.effort = 2;
poseRider.attacking = 2;
assertMountain(poseGame.riderPose(poseRider) === "standing",
  "El ciclista no se levanta durante un ataque");
poseRider.attacking = 0;
poseRider.energy = 18;
assertMountain(poseGame.riderPose(poseRider) === "fatigue",
  "El ciclista cansado no usa su postura propia");

const raceLeader = { distance: 50, finished: false, color: "#ffcc33" };
const raceMiddle = { distance: 47, finished: false, color: "#2f80ed" };
const raceTail = { distance: 44, finished: false, color: "#ef476f" };
const persistentVehicles = [
  { id: "tv-0", type: "tv", distance: 49.88, lateral: -0.52, speed: 40, active: true },
  { id: "tv-1", type: "tv", distance: 47.7, lateral: 0.5, speed: 35, active: true },
  { id: "tv-2", type: "tv", distance: 44.8, lateral: -0.08, speed: 31, active: true },
  { id: "team-0", type: "team", distance: 46.5, lateral: 0.5, speed: 29, active: true },
  { id: "broom", type: "broom", distance: 43.58, lateral: 0.55, speed: 27, active: true }
];
const vehicleGame = Object.create(Game.prototype);
vehicleGame.race = {
  player: raceMiddle,
  timeTrial: false,
  cyclists: [raceMiddle, raceTail, raceLeader],
  road: { lengthKm: 100, racePoints: [] },
  raceVehicles: persistentVehicles,
  groups: [
    { leader: raceLeader, tail: raceMiddle },
    { leader: raceTail, tail: raceTail }
  ]
};
const ambientVehicles = vehicleGame.ambientRaceVehicles();
const tvMotos = ambientVehicles.filter((vehicle) => vehicle.type === "tv");
const broomCar = ambientVehicles.find((vehicle) => vehicle.type === "broom");
assertMountain(tvMotos.length >= 3,
  "No aparecen varias motos de televisión durante la carrera");
assertMountain(tvMotos.every((vehicle) => vehicle.distance < raceLeader.distance),
  "Alguna moto de televisión circula por delante del líder");
assertMountain(ambientVehicles.some((vehicle) => vehicle.type === "team"),
  "No aparecen coches de equipo detrás de los grupos");
assertMountain(broomCar && broomCar.distance < raceTail.distance,
  "El coche escoba no cierra la carrera");
ambientVehicles.forEach((vehicle) => {
  assertMountain(Math.abs(vehicle.lateral) <= 0.62,
    "Un vehículo ambiental circula fuera de la carretera");
});
assertMountain(typeof vehicleGame.renderRaceVehicles === "function" &&
  typeof vehicleGame.renderLateralRaceVehicles === "function" &&
  typeof vehicleGame.drawRaceVehicle === "function" &&
  typeof vehicleGame.drawLateralRaceVehicle === "function",
  "Falta alguna vista de los vehículos de carrera");
assertMountain(vehicleGame.lateralRiderViewportScale(390) === 0.66 &&
  vehicleGame.lateralRiderViewportScale(1280) === 1,
  "Vehículos y ciclistas no pueden compartir una escala móvil estable");

const layerOrder = [];
const renderedRiderScales = new Map();
const layerGame = Object.create(vehicleGame);
Object.defineProperties(layerGame, {
  height: { value: 700 },
  roadHalfWidth: { value: 135 },
  riderHitAreas: { value: [] },
  roadPointAt: { value: (distance, lateral) => ({ x: lateral, y: distance }) },
  roadAngleAt: { value: () => 0 },
  drawCyclist: { value: (ctx, rider, x, y, scale) => {
    layerOrder.push(rider === raceMiddle ? "middle" : rider === raceTail ? "tail" : "leader");
    renderedRiderScales.set(rider, scale);
  } },
  drawRaceVehicle: { value: (ctx, vehicle) => layerOrder.push(vehicle.id) }
});
layerGame.race.weather = { intensity: 0 };
layerGame.race.player.draft = 0;
layerGame.race.player.wheelTarget = null;
layerGame.renderCyclists({});
assertMountain(layerOrder.indexOf("tail") < layerOrder.indexOf("team-0") &&
  layerOrder.indexOf("team-0") < layerOrder.indexOf("middle"),
  "Los coches no comparten el orden de profundidad con los ciclistas y pueden desaparecer bajo el pelotón");
assertMountain(renderedRiderScales.get(raceMiddle) === renderedRiderScales.get(raceTail) &&
  renderedRiderScales.get(raceMiddle) === renderedRiderScales.get(raceLeader),
  "El ciclista del jugador se sigue dibujando más grande que sus rivales");

const movingTrafficRace = Object.create(Race.prototype);
movingTrafficRace.teams = [{ color: "#2f80ed" }, { color: "#ef476f" }, { color: "#36bd69" }];
movingTrafficRace.road = { lengthKm: 100 };
movingTrafficRace.initializeRaceVehicles();
movingTrafficRace.timeTrial = false;
movingTrafficRace.player = raceMiddle;
movingTrafficRace.cyclists = [
  { ...raceLeader, speed: 38 },
  { ...raceMiddle, speed: 35 },
  { ...raceTail, speed: 31 }
];
movingTrafficRace.simulationScale = 20;
movingTrafficRace.updateRaceVehicles(0.5);
const movingMotos = movingTrafficRace.raceVehicles.filter((vehicle) => vehicle.type === "tv");
assertMountain(movingMotos.length === 3 &&
  movingMotos.every((vehicle) => vehicle.distance <= raceLeader.distance - 0.06),
  "Una moto puede colocarse por delante de la cabeza durante la actualización");
const orderedMotos = [...movingMotos].sort((a, b) => b.distance - a.distance);
assertMountain(orderedMotos.every((vehicle, index) =>
  index === 0 || orderedMotos[index - 1].distance - vehicle.distance >= 0.139),
  "Las motos pueden amontonarse en la misma posición");

const passingRider = {
  distance: 10, previousDistance: 9.99, lateral: 0.5, targetLateral: 0.5,
  speed: 40, targetSpeed: 40, finished: false, crashTimer: 0,
  intelligence: 82, avoidanceBrake: 0, avoiding: false
};
const trafficRace = Object.create(Race.prototype);
trafficRace.timeTrial = false;
trafficRace.player = passingRider;
trafficRace.cyclists = [passingRider];
trafficRace.proximityCache = new Map([[passingRider, []]]);
trafficRace.raceVehicles = [
  { id: "passable-car", type: "team", distance: 10.08, lateral: 0.5, speed: 27, active: true }
];
trafficRace.applyVehicleAvoidance();
assertMountain(Math.abs(passingRider.targetLateral - trafficRace.raceVehicles[0].lateral) >= 0.4,
  "El ciclista no cambia de trayectoria para adelantar al coche");
passingRider.distance = 10.06;
passingRider.lateral = 0.5;
trafficRace.resolveVehicleClearances();
assertMountain(passingRider.distance <= trafficRace.raceVehicles[0].distance - 0.052,
  "El ciclista puede atravesar un coche por la misma trayectoria");
passingRider.distance = 10.06;
passingRider.lateral = -0.8;
trafficRace.resolveVehicleClearances();
assertMountain(passingRider.distance === 10.06,
  "El ciclista no puede adelantar aunque use una trayectoria lateral libre");

const makeDescentRider = () => ({
  role: "leader", distance: 40, grip: 80, riskMode: "aggressive",
  riskAccumulator: 0, crashTimer: 0, finished: false, technique: 80,
  energy: 100, lateral: 0, targetLateral: 0, crashes: 0
});
const descentRace = Object.create(Race.prototype);
descentRace.elapsed = 5;
descentRace.difficulty = "normal";
descentRace.weather = { intensity: 0 };
descentRace.road = { getGradient: () => -8, curvatureAt: () => 0 };
descentRace.game = { cameraShake: 0, notify() {} };
descentRace.playerProfile = "allrounder";
descentRace.player = makeDescentRider();
for (let tick = 0; tick < 300 && descentRace.player.crashTimer <= 0; tick += 1) {
  descentRace.evaluateCrash(descentRace.player, 0.1);
}
assertMountain(descentRace.player.crashTimer > 0,
  "La conducción agresiva de un no sprinter no provoca riesgo real en bajada");

const sprinterRace = Object.create(Race.prototype);
sprinterRace.elapsed = 5;
sprinterRace.difficulty = "normal";
sprinterRace.weather = { intensity: 0 };
sprinterRace.road = descentRace.road;
sprinterRace.game = { cameraShake: 0, notify() {} };
sprinterRace.player = makeDescentRider();
sprinterRace.player.role = "sprinter";
for (let tick = 0; tick < 600; tick += 1) sprinterRace.evaluateCrash(sprinterRace.player, 0.1);
assertMountain(sprinterRace.player.crashTimer === 0,
  "El perfil sprinter recibe el riesgo específico de bajada agresiva");

const dynamicWeather = new WeatherSystem("dynamic", 200);
dynamicWeather.update(35);
assertMountain(dynamicWeather.state === "dry", "La lluvia dinámica empieza antes del tramo previsto");
dynamicWeather.update(36);
assertMountain(dynamicWeather.state === "light", "La lluvia dinámica no inicia un episodio largo");
dynamicWeather.update(111);
assertMountain(dynamicWeather.state === "heavy", "La lluvia no aumenta de intensidad");
dynamicWeather.update(199);
assertMountain(dynamicWeather.state === "heavy", "El episodio de lluvia termina antes de la etapa");

const wetRace = Object.create(Race.prototype);
wetRace.elapsed = 5;
wetRace.difficulty = "normal";
wetRace.weather = { intensity: 1 };
wetRace.road = { getGradient: () => 0, curvatureAt: () => 0 };
wetRace.game = { cameraShake: 0, notify() {} };
wetRace.playerProfile = "allrounder";
wetRace.player = makeDescentRider();
for (let tick = 0; tick < 500 && wetRace.player.crashTimer <= 0; tick += 1) {
  wetRace.evaluateCrash(wetRace.player, 0.1);
}
assertMountain(wetRace.player.crashTimer > 0,
  "La lluvia intensa no aumenta suficientemente las caídas en conducción agresiva");

const wetNormalRace = Object.create(Race.prototype);
wetNormalRace.elapsed = 5;
wetNormalRace.difficulty = "normal";
wetNormalRace.weather = { intensity: 1 };
wetNormalRace.road = wetRace.road;
wetNormalRace.game = { cameraShake: 0, notify() {} };
wetNormalRace.playerProfile = "allrounder";
wetNormalRace.player = { ...makeDescentRider(), riskMode: "normal" };
for (let tick = 0; tick < 700; tick += 1) wetNormalRace.evaluateCrash(wetNormalRace.player, 0.1);
assertMountain(wetNormalRace.player.crashTimer === 0,
  "La penalización combinada de lluvia se aplica también sin conducción agresiva");

const riderData = {
  name: "Test", team: "Solaris", color: "#ffcc33", role: "leader",
  climbing: 86, sprint: 82, endurance: 88, technique: 85, aggression: 78, intelligence: 88,
  distance: 20, lateral: 0, speed: 35
};
const flatRider = new Cyclist({ ...riderData });
const climbRider = new Cyclist({ ...riderData });
const weather = { intensity: 0 };
const raceContext = { isolationExposureFor: () => 0 };
const makeRoad = (gradient) => ({
  lengthKm: 180, stageProfile: "mountain",
  getGradient: () => gradient, curvatureAt: () => 0
});
flatRider.updateCommon(0.1, { road: makeRoad(0), weather, simulationScale: 60, race: raceContext });
climbRider.updateCommon(0.1, { road: makeRoad(8), weather, simulationScale: 60, race: raceContext });
const speedLoss = flatRider.targetSpeed - climbRider.targetSpeed;
assertMountain(speedLoss >= 7, "La subida no reduce bastante la velocidad");

JSON.stringify({
  climbs: climbs.length,
  averageLength: Number(averageLength.toFixed(2)),
  averageGradient: Number(averageGradient.toFixed(2)),
  longest: Number(Math.max(...climbs.map((climb) => climb.lengthKm)).toFixed(2)),
  steepest: Number(Math.max(...climbs.map((climb) => climb.averageGradient)).toFixed(2)),
  visualRise: Number(visualRise.toFixed(1)),
  visualRoadAngle: Number(visualRoadAngle.toFixed(3)),
  lateralRoadWidth: SIDE_ROAD_ASPHALT_WIDTH,
  finishGateHeight: SIDE_FINISH_GATE_HEIGHT,
  speedLossAt8Percent: Number(speedLoss.toFixed(1))
});
`;

eval(source + "\n" + tests);
