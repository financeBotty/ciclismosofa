ObjC.import("Foundation");

const projectPath = "/Users/mmp/Ciclismosofa/cycling-game/game.js";
const sourceString = $.NSString.stringWithContentsOfFileEncodingError(
  projectPath,
  $.NSUTF8StringEncoding,
  null
);
if (!sourceString) throw new Error("No se pudo leer game.js");

const source = ObjC.unwrap(sourceString).replace(
  /\nwindow\.CiclimoTourRace[\s\S]*$/,
  ""
);

const tests = String.raw`
const quickAssert = (condition, message) => {
  if (!condition) throw new Error(message);
};

const quickControls = {
  difficultySelect: { value: "normal" },
  weatherSelect: { value: "dynamic" },
  riderProfileSelect: { value: "allrounder" }
};
globalThis.document = {
  getElementById: (id) => quickControls[id] || {
    value: "",
    textContent: "",
    classList: { add() {}, remove() {}, toggle() {} },
    setAttribute() {},
    querySelector: () => ({ textContent: "" })
  }
};

const foundTypes = new Set();
for (let seed = 1; seed <= 240; seed += 1) {
  const stage = createQuickStage(seed);
  const key = stage.type === "itt" ? "itt"
    : stage.profile === "flat" ? "flat"
      : stage.profile === "mixed" ? "mixed" : "mountain";
  foundTypes.add(key);
  quickAssert(stage.quickRace === true, "La etapa no está marcada como carrera rápida");
  quickAssert(stage.number === 1, "La carrera rápida no usa una sola etapa");
  quickAssert(stage.lengthKm >= 24 && stage.lengthKm <= 280, "Distancia fuera de rango");
  quickAssert(Boolean(stage.name) && Boolean(stage.label), "Falta nombre o tipo de etapa");
}
["itt", "flat", "mixed", "mountain"].forEach((type) =>
  quickAssert(foundTypes.has(type), "No apareció el tipo aleatorio: " + type)
);

const quickGame = Object.create(Game.prototype);
quickGame.activeSaveSlot = null;
quickGame.storage = {
  bestPosition: null, bestTime: null, races: 0, wins: 0,
  difficulty: "normal", weather: "dynamic", playerProfile: "allrounder"
};
quickGame.saveTour = () => false;
quickGame.renderSaveSlots = () => {};
quickGame.notify = () => {};
quickGame.tour = quickGame.createQuickRaceSession();
quickGame.ensureTourRoster();
quickAssert(quickGame.tour.quickRace === true, "La sesión no es una carrera rápida");
quickAssert(quickGame.tour.stages.length === 1, "La sesión rápida contiene más de una etapa");
quickAssert(quickGame.tour.roster.length === 100, "La carrera rápida no tiene 100 ciclistas");

const quickRace = quickGame.createCurrentRace({ simulationOnly: true });
quickAssert(quickRace.cyclists.length === 100, "El simulador no recibió los 100 ciclistas");
quickAssert(quickRace.road.timeOfDay === "day", "La etapa no está fijada en horario diurno");
quickAssert(
  quickRace.road.sceneryZones.every((zone) => zone.timeOfDay === "day"),
  "Algún escenario de la etapa no está marcado como diurno"
);
quickAssert(
  quickRace.timeTrial === (quickGame.tour.stages[0].type === "itt"),
  "El modo contrarreloj no coincide con la etapa generada"
);

JSON.stringify({
  variants: [...foundTypes].sort(),
  stage: quickGame.tour.stages[0],
  cyclists: quickRace.cyclists.length
});
`;

eval(source + "\n" + tests);
